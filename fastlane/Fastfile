default_platform(:ios)

TARGET_VERSION = '1.0.1'
DEFAULT_APP_IDENTIFIER = 'com.company.fstudy'

def env_present?(key)
  !ENV[key].to_s.strip.empty?
end

def asc_api_key_available?
  env_present?('ASC_KEY_ID') && env_present?('ASC_KEY_FILE')
end

private_lane :auth_options do
  if asc_api_key_available?
    api_opts = {
      key_id: ENV.fetch('ASC_KEY_ID'),
      key_filepath: ENV.fetch('ASC_KEY_FILE'),
      duration: 1200,
      in_house: false,
    }
    api_opts[:issuer_id] = ENV['ASC_ISSUER_ID'] if env_present?('ASC_ISSUER_ID')
    { api_key: app_store_connect_api_key(**api_opts) }
  else
    username = ENV['FASTLANE_USER'] || ENV['APP_STORE_CONNECT_USERNAME']
    UI.user_error!('Missing auth. Set ASC_KEY_ID+ASC_KEY_FILE or FASTLANE_USER.') if username.to_s.strip.empty?
    { username: username }
  end
end

private_lane :deliver_options do |options|
  auth = options.fetch(:auth)
  locales_raw = ENV['APPSTORE_LOCALES']
  locales = locales_raw.to_s.split(',').map(&:strip).reject(&:empty?)

  result = {
    app_identifier: ENV['APP_IDENTIFIER'].to_s.strip.empty? ? DEFAULT_APP_IDENTIFIER : ENV['APP_IDENTIFIER'],
    app_version: TARGET_VERSION,
    platform: 'ios',
    metadata_path: 'fastlane/metadata',
    skip_binary_upload: true,
    skip_metadata: false,
    skip_screenshots: true,
    submit_for_review: false,
    force: true,
    run_precheck_before_submit: false,
    precheck_include_in_app_purchases: false,
  }.merge(auth)

  result[:languages] = locales unless locales.empty?
  itc_provider = ENV['ITC_PROVIDER']
  result[:itc_provider] = itc_provider unless itc_provider.to_s.strip.empty?
  result
end

platform :ios do
  desc 'Prepare App Store metadata for 1.0.1'
  lane :appstore_metadata_prepare do
    sh('cd .. && node scripts/prepare-appstore-metadata.mjs')
  end

  desc 'Validate App Store metadata for 1.0.1'
  lane :appstore_metadata_verify do
    sh('cd .. && node scripts/validate-asc-metadata.mjs')
  end

  desc 'Upload App Store metadata for 1.0.1 (metadata only)'
  lane :appstore_metadata_upload do
    appstore_metadata_verify
    auth = auth_options
    deliver(**deliver_options(auth: auth))
  end
end
