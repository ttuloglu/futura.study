{
  "name": "f-study",
  "private": true,
  "version": "1.0.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "sync:ios": "npm run build && npx cap sync ios",
    "i18n:check": "node scripts/i18n/check-ui-i18n.mjs && node scripts/i18n/check-translation-coverage.mjs --fail-on-missing",
