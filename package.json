    "community:backfill": "node scripts/backfill-community-books.mjs"
  },
  "dependencies": {
    "@capacitor-community/photoviewer": "^8.0.0",
    "@capacitor-firebase/messaging": "^8.2.0",
    "@capacitor/android": "^8.1.0",
    "@capacitor/app": "^8.1.0",
    "@capacitor/core": "^8.1.0",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/ios": "^8.1.0",
    "@capacitor/local-notifications": "^8.0.2",
    "@capacitor/screen-orientation": "^8.0.1",
    "@capacitor/share": "^8.0.1",
    "@capgo/capacitor-social-login": "^8.3.8",
    "@revenuecat/purchases-capacitor": "^12.2.1",
    "@revenuecat/purchases-capacitor-ui": "^12.2.1",
